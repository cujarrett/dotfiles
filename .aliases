# Two files: diff them. One file: diff it against its last commit (HEAD).
function vsdiff {
  if [ $# -eq 1 ]; then
    local dir="$(dirname "$1")" name="$(basename "$1")"
    local old="$(mktemp -d)/HEAD-$name"
    git -C "$dir" show "HEAD:./$name" > "$old" && code --diff "$old" "$1"
  else
    code --diff "$@"
  fi
}

alias k="kubectl"

alias python="python3"
alias pip="pip3"

alias kioskreboot='ssh pi@192.168.10.100 "sudo systemctl restart getty@tty1.service"'

alias homelabcert='k get secret local-lab-ca-secret -n cert-manager -o jsonpath="{.data.tls\.crt}" | base64 -d > ~/Desktop/local-lab-ca.crt && echo "Certificate saved to ~/Desktop/local-lab-ca.crt. On iPad: Settings > General > VPN & Device Management to install, then Settings > VPN to enable"'

# Screenshots the ctrl-1 kiosk display and opens it.
#   1. ssh pi@... - runs the quoted command remotely on the Pi
#   2. rm -f ... - deletes any leftover screenshot from a previous run
#   3. DISPLAY=:0 scrot ... - takes the screenshot; DISPLAY=:0 is required because an SSH session has no display set otherwise
#   4. scp pi@...:file file - copies the screenshot from the Pi down to this Mac (remote path : local path)
#   5. open file - opens the local copy in Preview
alias kioskscreenshot='ssh pi@192.168.10.100 "rm -f /tmp/kiosk*.png && DISPLAY=:0 scrot /tmp/kiosk.png" && scp pi@192.168.10.100:/tmp/kiosk.png /tmp/kiosk.png && open /tmp/kiosk.png'

# Reports WordPress version drift across every homelab site — running vs pinned
# vs latest image vs latest release. Reads the pinned variant straight out of the
# composition, so it never needs updating when the PHP pin moves.
alias wpstatus='~/Developer/homelab/docs/wordpress/status-wordpress.sh'

# Walks every git repo under ~/Developer and flags uncommitted or unpushed work.
# Silent for a clean repo - only prints repos that need attention.
devcheck() {
  local root="${1:-$HOME/Developer}"
  local found=0

  while IFS= read -r -d '' gitdir; do
    local repo="${gitdir%/.git}"
    local name="${repo#"$root"/}"

    ( cd "$repo" || exit 0

      # A repo with no commits yet (freshly `git init`'d) has no HEAD - nothing to flag.
      git rev-parse HEAD >/dev/null 2>&1 || exit 0

      local dirty ahead upstream noupstream=0
      dirty=$(git status --porcelain 2>/dev/null)
      upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
      if [ -n "$upstream" ]; then
        ahead=$(git rev-list --count '@{u}..HEAD' 2>/dev/null)
      else
        noupstream=1
      fi

      if [ -n "$dirty" ] || { [ -n "$ahead" ] && [ "$ahead" != "0" ]; } || [ "$noupstream" = "1" ]; then
        echo "=== $name ==="
        [ -n "$dirty" ] && git status --short
        if [ -n "$ahead" ] && [ "$ahead" != "0" ]; then
          echo "  $ahead commit(s) ahead of $upstream, not pushed"
        fi
        [ "$noupstream" = "1" ] && echo "  no upstream tracking branch set - nothing ever pushed from this branch"
        echo ""
      fi
    )
  done < <(find "$root" -type d -name .git -not -path '*/node_modules/*' -print0 2>/dev/null)

  echo "devcheck: scanned repos under $root"
}

alias cleanraws="clean-up-raws.sh"
