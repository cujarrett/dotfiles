alias cleanraws="clean-up-raws.sh"

alias vssettings="open -a 'Visual Studio Code' \"$HOME/Library/Application Support/Code/User/settings.json\""

alias k="kubectl"

alias python="python3"
alias pip="pip3"

alias tf="terraform"

alias kioskreboot='ssh pi@192.168.10.100 "sudo systemctl restart getty@tty1.service"'

alias homelabcert='k get secret local-lab-ca-secret -n cert-manager -o jsonpath="{.data.tls\.crt}" | base64 -d > ~/Desktop/local-lab-ca.crt && echo "Certificate saved to ~/Desktop/local-lab-ca.crt. On iPad: Settings > General > VPN & Device Management to install, then Settings > VPN to enable"'

# Screenshots the ctrl-1 kiosk display and opens it.
#   1. ssh pi@... - runs the quoted command remotely on the Pi
#   2. rm -f ... - deletes any leftover screenshot from a previous run
#   3. DISPLAY=:0 scrot ... - takes the screenshot; DISPLAY=:0 is required because an SSH session has no display set otherwise
#   4. scp pi@...:file file - copies the screenshot from the Pi down to this Mac (remote path : local path)
#   5. open file - opens the local copy in Preview
alias kioskscreenshot='ssh pi@192.168.10.100 "rm -f /tmp/kiosk*.png && DISPLAY=:0 scrot /tmp/kiosk.png" && scp pi@192.168.10.100:/tmp/kiosk.png /tmp/kiosk.png && open /tmp/kiosk.png'

# One line per check: green + a count when it's clean, red + the offending rows
# indented underneath when it's not. A wall of "=== Section ===" headers over
# mostly-empty output makes the one broken thing hard to spot; this doesn't.
_kcheck_line() {
  local label="$1" bad="$2" note="$3"
  if [ -z "$bad" ]; then
    printf "\033[32m✓\033[0m %s%s\n" "$label" "${note:+ ($note)}"
  else
    printf "\033[31m✗\033[0m %s%s\n" "$label" "${note:+ ($note)}"
    echo "$bad" | sed 's/^/      /'
  fi
}

kcheck() {
  local total bad

  total=$(k get nodes --no-headers | wc -l | tr -d ' ')
  bad=$(k get nodes --no-headers | awk '$2!="Ready" {print $1, $2}')
  _kcheck_line "Cluster Nodes" "$bad" "$total total"

  # "applications" is ambiguous - Crossplane's Entra provider registers a CRD by
  # the same plural name, so the bare short name silently picks the wrong one.
  total=$(k get applications.argoproj.io -n argocd --no-headers | wc -l | tr -d ' ')
  bad=$(k get applications.argoproj.io -n argocd --no-headers | awk '$2!="Synced" || $3!="Healthy" {print $1, $2, $3}')
  _kcheck_line "Argo Apps" "$bad" "$total total"

  bad=$(k get pods -A --no-headers | grep -v "Running\|Completed" | awk '{print $1, $2, $4}')
  _kcheck_line "Pods" "$bad"

  total=$(k get composite --no-headers 2>/dev/null | wc -l | tr -d ' ')
  bad=$(k get composite --no-headers 2>/dev/null | awk '$2!="True" || $3!="True" {print $1, "SYNCED="$2, "READY="$3}')
  _kcheck_line "Crossplane XRs" "$bad" "$total total"

  bad=$(k get pvc -A --no-headers | grep -v Bound | awk '{print $1, $2, $3}')
  _kcheck_line "PVCs Bound" "$bad"

  bad=$(k get volumes -n longhorn-system --no-headers 2>/dev/null | awk '$3=="detached" && $7=="" {print $1, $3}')
  _kcheck_line "Longhorn Volumes" "$bad"

  bad=$(k get providers.pkg.crossplane.io --no-headers 2>/dev/null | awk '$3!="True" {print $1, "HEALTHY="$3}')
  _kcheck_line "Crossplane Providers" "$bad"

  # "k get managed" walks every registered CRD via discovery - 100 API round trips
  # over the Tailscale link, 30-40s. Naming the AWS + Entra kinds explicitly turns
  # it into one list call per kind, under 2s, and jq reads the Ready condition
  # directly instead of guessing at column position across differently-shaped tables.
  bad=$(k get \
    role.iam.aws.upbound.io,bucket.s3.aws.upbound.io,table.dynamodb.aws.upbound.io,replicationgroup.elasticache.aws.upbound.io,\
application.applications.azuread.upbound.io,approle.applications.azuread.upbound.io,federatedidentitycredential.applications.azuread.upbound.io,\
principal.serviceprincipals.azuread.upbound.io,roleassignment.app.azuread.upbound.io \
    -o json 2>/dev/null | jq -r '
      .items[] | select([.status.conditions[]? | select(.type=="Ready" and .status=="True")] | length == 0)
      | .kind + "/" + .metadata.name')
  _kcheck_line "AWS / Entra Managed Resources" "$bad"

  # "certificates" is another ambiguous short name - Crossplane's Entra provider
  # registers a CRD by the same plural, so this must be fully qualified too.
  #
  # jq, not awk on --no-headers: a blank DENIED/SECRET column collapses in
  # whitespace-split table output, so fixed field numbers land on the wrong value
  # depending on the row. Reading .status.conditions avoids that entirely.
  bad=$(k get certificates.cert-manager.io -A -o json 2>/dev/null | jq -r '
    .items[] | select([.status.conditions[]? | select(.type=="Ready" and .status=="True")] | length == 0)
    | .metadata.namespace + " " + .metadata.name')
  _kcheck_line "Certificates" "$bad"

  bad=$(k get certificaterequests.cert-manager.io -A -o json 2>/dev/null | jq -r '
    .items[] | select([.status.conditions[]? | select(.type=="Ready" and .status=="True")] | length == 0)
    | .metadata.namespace + " " + .metadata.name')
  _kcheck_line "CertificateRequests" "$bad"
}

# Reports WordPress version drift across every homelab site — running vs pinned
# vs latest image vs latest release. Reads the pinned variant straight out of the
# composition, so it never needs updating when the PHP pin moves.
alias wpstatus='~/Developer/homelab/docs/wordpress/status-wordpress.sh'

# Walks every git repo under ~/Developer and flags uncommitted or unpushed work.
# Silent for a clean repo - only prints repos that need attention.
devcheck() {
  local root="${1:-$HOME/Developer}"
  local found=0

  while IFS= read -r -d '' gitdir; do
    local repo="${gitdir%/.git}"
    local name="${repo#"$root"/}"

    ( cd "$repo" || exit 0

      # A repo with no commits yet (freshly `git init`'d) has no HEAD - nothing to flag.
      git rev-parse HEAD >/dev/null 2>&1 || exit 0

      local dirty ahead upstream noupstream=0
      dirty=$(git status --porcelain 2>/dev/null)
      upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
      if [ -n "$upstream" ]; then
        ahead=$(git rev-list --count '@{u}..HEAD' 2>/dev/null)
      else
        noupstream=1
      fi

      if [ -n "$dirty" ] || { [ -n "$ahead" ] && [ "$ahead" != "0" ]; } || [ "$noupstream" = "1" ]; then
        echo "=== $name ==="
        [ -n "$dirty" ] && git status --short
        if [ -n "$ahead" ] && [ "$ahead" != "0" ]; then
          echo "  $ahead commit(s) ahead of $upstream, not pushed"
        fi
        [ "$noupstream" = "1" ] && echo "  no upstream tracking branch set - nothing ever pushed from this branch"
        echo ""
      fi
    )
  done < <(find "$root" -type d -name .git -not -path '*/node_modules/*' -print0 2>/dev/null)

  echo "devcheck: scanned repos under $root"
}
